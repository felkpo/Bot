# Discord Bot Configuration
DISCORD_TOKEN=your_token_here
CLIENT_ID=seu_client_id_aqui

# AI Provider Selection (openrouter | multi-provider | gemini | groq | workers)
AI_PROVIDER=multi-provider

# OpenRouter Configuration
OPENROUTER_API_KEY=your_token_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Gemini Configuration
GEMINI_API_KEY=your_token_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Groq Configuration
GROQ_API_KEY=your_token_here
GROQ_MODEL=llama-3.3-70b-versatile

# AI Workspace / Cloudflare Workers Configuration
WORKERS_API_KEY=your_token_here
WORKERS_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Ollama Configuration (Local) - DEPRECATED (migrado para OpenRouter)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Ollama Thinking/Reasoning
# Set to false for faster responses (no "Thought for X seconds")
# Set to true for deeper reasoning (slower, ~40-110 seconds)
ENABLE_THINKING=false

# Network Configuration
# Force IPv4 for Discord connection (helps with connectivity issues on some networks)
FORCE_IPV4=true

# Logging
LOG_LEVEL=info

# Teste de isolamento: usa message.channel.send() em vez de message.reply()
# true = usa channel.send(), false = usa reply()
USE_CHANNEL_SEND=false

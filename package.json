{
  "name": "royal-prussian-bot",
  "version": "2.0.0",
  "description": "Royal Prussian - Assistente Virtual com IA Discord",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "pm2:install": "npm install -g pm2",
    "pm2:start": "pm2 start index.js --name \"Royal Prussian\" --watch src",
    "pm2:stop": "pm2 stop \"Royal Prussian\"",
    "pm2:restart": "pm2 restart \"Royal Prussian\"",
    "pm2:logs": "pm2 logs \"Royal Prussian\"",
    "pm2:list": "pm2 list",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "dependencies": {
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
